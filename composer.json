{
    "name": "adems/dapur-asset",
    "description": "Aset Dapur AdeMS, untuk mengelola segala file dan dokumen aset di Dapur Tempat AdeMS.",
    "license": "BSD-3-Clause",
    "keywords": [
        "asset",
        "dapur",
        "php",
        "laminas",
        "mezzio",
        "middleware"
    ],
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laminas": {
            "config-provider": "Adems\\Asset\\ConfigProvider"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "autoload": {
        "psr-4": {
            "Adems\\Asset\\": "src/"
        }
    }
}